# Copy to .env for local development (npm run dev). Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://learnloop:learnloop@localhost:5432/learnloop
REDIS_URL=redis://localhost:6379
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-or-more
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# AI provider: mock (no key needed), gemini (free key from https://aistudio.google.com), or ollama (local)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
